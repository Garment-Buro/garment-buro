# Copy this file to /srv/garment-buro/<environment>/.env and set mode 0600.
# Use different passwords and encryption keys for production and development.

DEPLOY_ENV=production
APP_ENV=production
PUBLIC_HOST=garment-buro.ru
PUBLIC_BASE_URL=https://garment-buro.ru
CORS_ORIGINS=https://garment-buro.ru,https://www.garment-buro.ru

FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
MINIO_HOST_PORT=9000

POSTGRES_DB=garment_buro_production
POSTGRES_USER=garment
POSTGRES_PASSWORD=replace-with-url-safe-random-value
DATABASE_ENABLED=true
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

LEGACY_DATABASE_URL=sqlite:////app/legacy/ecommerce.db

REDIS_URL=redis://redis:6379/0
PRODUCTS_CACHE_TTL_SECONDS=3600
PRODUCT_CACHE_TTL_SECONDS=3600
CART_CACHE_TTL_SECONDS=2592000

MINIO_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-random-access-key
MINIO_SECRET_KEY=replace-with-random-secret-key
MINIO_SECURE=false
MINIO_BUCKET_PREFIX=garment-buro
MINIO_PUBLIC_BASE_URL=https://garment-buro.ru/storage
MINIO_PRESIGNED_EXPIRE_SECONDS=900
MEDIA_MAX_UPLOAD_BYTES=104857600
CRM_FILE_MAX_UPLOAD_BYTES=26214400

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=43200
IDENTITY_OTP_PEPPER=replace-with-independent-random-value
IDENTITY_OTP_DIGITS=4
IDENTITY_OTP_EXPIRE_MINUTES=10
IDENTITY_OTP_RESEND_SECONDS=60
IDENTITY_OTP_HOURLY_LIMIT=5
IDENTITY_OTP_MAX_ATTEMPTS=5
IDENTITY_ACCESS_EXPIRE_MINUTES=15
IDENTITY_REFRESH_EXPIRE_DAYS=30
IDENTITY_MAX_ACTIVE_SESSIONS=10
IDENTITY_REFRESH_COOKIE_NAME=gb_refresh

CATALOG_READS_ENABLED=false
CATALOG_WRITES_ENABLED=false
CATALOG_MIGRATION_FINGERPRINT=
CATALOG_CONTENT_MIGRATION_FINGERPRINT=
CARTS_V2_ENABLED=false
CARTS_MIGRATION_FINGERPRINT=
ORDER_READS_ENABLED=false
ORDER_MIGRATION_FINGERPRINT=
CHECKOUT_V2_ENABLED=false
IDENTITY_API_ENABLED=false
IDENTITY_MIGRATION_FINGERPRINT=
IDENTITY_LEGACY_TOKEN_GRACE_UNTIL=
CRM_API_ENABLED=false
CRM_WRITES_ENABLED=false
CRM_FILES_ENABLED=false
CDEK_QUOTE_ENABLED=false
CDEK_CREATION_ENABLED=false
PAYMENT_CREATION_ENABLED=false
PAYMENT_WEBHOOK_V2_ENABLED=false
PAYMENT_RECONCILIATION_ENABLED=false
FULFILLMENT_OUTBOX_ENABLED=false
FULFILLMENT_EMAIL_ENABLED=false
FULFILLMENT_CDEK_ENABLED=false
FULFILLMENT_CRM_ENABLED=false

NOTIFICATION_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
NOTIFICATION_PREVIOUS_ENCRYPTION_KEYS=
NOTIFICATION_ENCRYPTION_KEY_VERSION=1

CDEK_API_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=replace-with-server-secret
CDEK_CLIENT_SECRET=replace-with-server-secret
CDEK_REQUEST_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
CDEK_PREVIOUS_REQUEST_ENCRYPTION_KEYS=
CDEK_REQUEST_ENCRYPTION_KEY_VERSION=1
CDEK_SENDER_NAME=GARMENT BURO
CDEK_SENDER_CITY_CODE=245
CDEK_PICKUP_POINT_CODE=TVR8
CDEK_WAREHOUSE_TO_WAREHOUSE_TARIFF=136
CDEK_WAREHOUSE_TO_DOOR_TARIFF=137

YOOKASSA_SHOP_ID=replace-with-server-secret
YOOKASSA_API_KEY=replace-with-rotated-server-secret
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_WEBHOOK_URL=https://garment-buro.ru/api/webhooks/yookassa
YOOKASSA_RECEIPT_TAX_SYSTEM_CODE=
YOOKASSA_RECEIPT_PRODUCT_VAT_CODE=
YOOKASSA_RECEIPT_DELIVERY_VAT_CODE=
YOOKASSA_RECEIPT_PRODUCT_PAYMENT_MODE=
YOOKASSA_RECEIPT_DELIVERY_PAYMENT_MODE=
YOOKASSA_RECEIPT_PRODUCT_SUBJECT=
YOOKASSA_RECEIPT_DELIVERY_SUBJECT=

SMTP_SERVER=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_USER=noreply@garment-buro.ru
SMTP_PASSWORD=replace-with-server-secret
SMTP_USE_SSL=true

# Leave empty until the corresponding integrations are reviewed and enabled.
COMPOSE_PROFILES=
