# Runtime environment: local, test, staging or production.
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:3000
PARTNER_PUBLIC_BASE_URL=https://partner.garment-buro.ru
WIDGET_PUBLIC_BASE_URL=https://widget.garment-buro.ru
LEGACY_DATABASE_URL=sqlite:///./ecommerce.db
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
CATALOG_READS_ENABLED=false
CATALOG_WRITES_ENABLED=false
CATALOG_MIGRATION_FINGERPRINT=
CATALOG_CONTENT_MIGRATION_FINGERPRINT=
CARTS_V2_ENABLED=false
CARTS_MIGRATION_FINGERPRINT=
INVENTORY_RESERVATION_TTL_SECONDS=1800
ORDER_READS_ENABLED=false
ORDER_MIGRATION_FINGERPRINT=
CHECKOUT_V2_ENABLED=false
PARTNER_PROGRAM_ENABLED=false
PARTNER_ATTRIBUTION_SECRET=replace-with-partner-attribution-secret
PARTNER_ATTRIBUTION_DAYS=30
PARTNER_COMMISSION_HOLD_DAYS=14
PARTNER_ATTRIBUTION_COOKIE_NAME=gb_partner
PARTNER_VISITOR_COOKIE_NAME=gb_partner_visitor
PARTNER_COOKIE_DOMAIN=
CRM_API_ENABLED=false
CRM_WRITES_ENABLED=false
CRM_FILES_ENABLED=false
ORDER_GUEST_ACCESS_TTL_DAYS=30

MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_PREFIX=garment-buro
MINIO_PUBLIC_BASE_URL=http://localhost:9000
MINIO_PRESIGNED_EXPIRE_SECONDS=900
MEDIA_MAX_UPLOAD_BYTES=104857600
CRM_FILE_MAX_UPLOAD_BYTES=26214400

POSTGRES_DB=garment_buro
POSTGRES_USER=garment
POSTGRES_PASSWORD=
# Separate non-owner role used by the API and workers.
DATABASE_APP_USER=garment_app
DATABASE_APP_PASSWORD=

REDIS_URL=redis://redis:6379/0
PRODUCTS_CACHE_TTL_SECONDS=3600
PRODUCT_CACHE_TTL_SECONDS=3600
CART_CACHE_TTL_SECONDS=2592000

# Generate a unique value of at least 32 characters for every environment.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=43200
IDENTITY_OTP_PEPPER=
IDENTITY_OTP_DIGITS=4
IDENTITY_OTP_EXPIRE_MINUTES=10
IDENTITY_OTP_RESEND_SECONDS=60
IDENTITY_OTP_HOURLY_LIMIT=5
IDENTITY_OTP_MAX_ATTEMPTS=5
IDENTITY_ACCESS_EXPIRE_MINUTES=15
IDENTITY_REFRESH_EXPIRE_DAYS=30
IDENTITY_MAX_ACTIVE_SESSIONS=10
IDENTITY_API_ENABLED=false
# Exact reviewed identity dry-run fingerprint required before guarded auth cutover.
IDENTITY_MIGRATION_FINGERPRINT=
# Optional timezone-aware ISO-8601 cutoff within 31 days for pre-cutover bearer tokens.
IDENTITY_LEGACY_TOKEN_GRACE_UNTIL=
IDENTITY_REFRESH_COOKIE_NAME=gb_refresh
IDENTITY_PASSWORD_AUTH_ENABLED=true
IDENTITY_PASSWORD_MAX_ATTEMPTS=5
IDENTITY_PASSWORD_LOCKOUT_MINUTES=15
# Reserved provider boundary. Keep false until an SMS provider is selected.
IDENTITY_PHONE_AUTH_ENABLED=false
IDENTITY_TELEGRAM_AUTH_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_API_URL=https://api.telegram.org
# Build-time frontend cutover flag. Enable only together with IDENTITY_API_ENABLED.
NEXT_PUBLIC_IDENTITY_SESSION_V2_ENABLED=false
NEXT_PUBLIC_CATALOG_WRITES_ENABLED=false
# Build-time staff surface. Enable only after CRM_API_ENABLED and staging RBAC verification.
NEXT_PUBLIC_CRM_CABINET_ENABLED=false
# Public browser key. Restrict it to the approved Garment Buro origins in Yandex Cloud.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# URL-safe base64 encoding of exactly 32 random bytes. Keep it separate from JWT/OTP secrets.
NOTIFICATION_ENCRYPTION_KEY=
# JSON object of old version-to-key pairs retained until old outbox rows are drained.
NOTIFICATION_PREVIOUS_ENCRYPTION_KEYS=
NOTIFICATION_ENCRYPTION_KEY_VERSION=1
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_CAP_SECONDS=3600
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_TELEGRAM_ENABLED=false
# Reserved provider boundary. Keep false until an SMS provider is selected.
NOTIFICATION_PHONE_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CDEK_API_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Independent AES-256-GCM key for immutable CDEK request bytes.
CDEK_REQUEST_ENCRYPTION_KEY=
# JSON object of old version-to-key pairs retained while pending shipments exist.
CDEK_PREVIOUS_REQUEST_ENCRYPTION_KEYS=
CDEK_REQUEST_ENCRYPTION_KEY_VERSION=1
CDEK_SENDER_NAME=GARMENT BURO
CDEK_SENDER_CITY_CODE=245
CDEK_PICKUP_POINT_CODE=TVR8
CDEK_WAREHOUSE_TO_WAREHOUSE_TARIFF=136
CDEK_WAREHOUSE_TO_DOOR_TARIFF=137
CDEK_MAX_PACKAGES=100
FULFILLMENT_CDEK_ENABLED=false
FULFILLMENT_CRM_ENABLED=false
CDEK_QUOTE_ENABLED=false
CDEK_CREATION_ENABLED=false
CDEK_CREATION_MAX_ATTEMPTS=5
CDEK_TIMEOUT_SECONDS=15
CDEK_RETRY_BASE_SECONDS=30
CDEK_RETRY_CAP_SECONDS=1800
CDEK_PROCESSING_TIMEOUT_SECONDS=120
CDEK_POLL_SECONDS=5

YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT_SECONDS=10
YOOKASSA_WEBHOOK_URL=
# Keep disabled until the fiscal receipt values below are confirmed with accounting
# and a YooKassa test payment has passed end to end.
PAYMENT_CREATION_ENABLED=false
# Retry the exact same request/key for at most 23 hours (YooKassa guarantees 24 hours).
PAYMENT_CREATION_RETRY_WINDOW_SECONDS=82800
PAYMENT_CREATION_PROCESSING_TIMEOUT_SECONDS=60
# Staff-only capture/cancel API for two-stage payments. Also enable webhook or reconciliation.
PAYMENT_MANAGEMENT_ENABLED=false
PAYMENT_OPERATION_PROCESSING_TIMEOUT_SECONDS=60
# Total attempts per order, including the initial checkout attempt.
PAYMENT_MAX_ATTEMPTS_PER_ORDER=3

# Payouts use a separate YooKassa gateway (agentId) and secret key, never shop credentials.
YOOKASSA_PAYOUT_AGENT_ID=
YOOKASSA_PAYOUT_API_KEY=
YOOKASSA_PAYOUTS_ENABLED=false
PAYOUT_RETRY_WINDOW_SECONDS=82800
PAYOUT_PROCESSING_TIMEOUT_SECONDS=60
# Atomically schedule email, CDEK and CRM work after verified payment success.
# Keep disabled until migration 0017 is applied; network workers are enabled separately.
FULFILLMENT_OUTBOX_ENABLED=false
FULFILLMENT_EMAIL_ENABLED=false
FULFILLMENT_MAX_ATTEMPTS=5
FULFILLMENT_RETRY_BASE_SECONDS=30
FULFILLMENT_RETRY_CAP_SECONDS=1800
FULFILLMENT_PROCESSING_TIMEOUT_SECONDS=300
FULFILLMENT_POLL_SECONDS=5
# Explicit 54-FZ contract. Do not copy sample values without accounting approval.
YOOKASSA_RECEIPT_TAX_SYSTEM_CODE=
YOOKASSA_RECEIPT_PRODUCT_VAT_CODE=
YOOKASSA_RECEIPT_DELIVERY_VAT_CODE=
YOOKASSA_RECEIPT_PRODUCT_PAYMENT_MODE=
YOOKASSA_RECEIPT_DELIVERY_PAYMENT_MODE=
# Product: commodity or non_marked. Marked goods require a future marking-code stage.
YOOKASSA_RECEIPT_PRODUCT_SUBJECT=
YOOKASSA_RECEIPT_DELIVERY_SUBJECT=
PAYMENT_WEBHOOK_V2_ENABLED=false
# Comma-separated direct reverse-proxy networks allowed to supply X-Forwarded-For.
# Keep empty for direct provider-to-ASGI traffic. Never use 0.0.0.0/0 or ::/0.
PAYMENT_WEBHOOK_TRUSTED_PROXY_CIDRS=
PAYMENT_EVENT_MAX_ATTEMPTS=5
PAYMENT_EVENT_RETRY_BASE_SECONDS=30
PAYMENT_EVENT_RETRY_CAP_SECONDS=1800
PAYMENT_EVENT_PROCESSING_TIMEOUT_SECONDS=300
PAYMENT_EVENT_POLL_SECONDS=5
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_MAX_ATTEMPTS=288
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=300
PAYMENT_RECONCILIATION_RETRY_BASE_SECONDS=30
PAYMENT_RECONCILIATION_RETRY_CAP_SECONDS=1800
PAYMENT_RECONCILIATION_PROCESSING_TIMEOUT_SECONDS=300
PAYMENT_RECONCILIATION_POLL_SECONDS=5

SMTP_SERVER=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_USER=noreply@garment-buro.ru
SMTP_PASSWORD=
SMTP_USE_SSL=true
